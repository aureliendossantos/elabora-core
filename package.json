{
  "name": "elabora",
  "version": "0.1.0",
  "private": true,
  "description": "Open core of Elabora, the e-learning authoring tool where AI agents co-author: the course format, a validator, a SCORM 1.2 and web compiler, the elabora command line and an MCP server.",
  "keywords": [
    "e-learning",
    "elearning",
    "scorm",
    "scorm-1.2",
    "lms",
    "course-authoring",
    "mcp",
    "mcp-server",
    "ai-agents",
    "accessibility"
  ],
  "homepage": "https://elabora.studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aureliendossantos/elabora-core.git"
  },
  "bugs": {
    "url": "https://github.com/aureliendossantos/elabora-core/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "elabora": "bin/elabora.js"
  },
  "files": [
    "bin/",
    "packages/cli/package.json",
    "packages/cli/src/",
    "packages/core/package.json",
    "packages/core/src/",
    "packages/engine/package.json",
    "packages/engine/src/",
    "packages/fonts/package.json",
    "packages/fonts/src/",
    "packages/format/package.json",
    "packages/format/src/",
    "packages/node/package.json",
    "packages/node/src/",
    "packages/player/package.json",
    "packages/player/src/",
    "packages/cli/bin/",
    "packages/cli/skills/",
    "packages/core/profiles/",
    "packages/fonts/README.md",
    "packages/fonts/catalogue.json",
    "packages/fonts/files/",
    "packages/format/schemas/",
    "packages/node/emulator-harness/",
    "packages/node/sounds/",
    "packages/node/templates/",
    "packages/node/vendor/",
    "packages/node/voices/",
    "templates/",
    "docs/",
    "!docs/images/",
    "SPEC.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test --test-force-exit --test-global-setup=test/isolate.ts --test-concurrency=4 \"test/unit/*.test.ts\"",
    "test:file": "node --test --test-force-exit --test-global-setup=test/isolate.ts --import ./scripts/heavy-slots.ts",
    "test:e2e": "node --test --test-force-exit --test-global-setup=test/isolate.ts --import ./scripts/heavy-slots.ts --test-concurrency=2 \"test/e2e/*.test.ts\"",
    "test:matrix": "node --test --test-force-exit --test-global-setup=test/isolate.ts --import ./scripts/heavy-slots.ts --test-concurrency=2 \"test/matrix/*.test.ts\"",
    "test:all": "pnpm test && pnpm run test:e2e && pnpm run test:matrix",
    "test:affected": "node scripts/test-affected.ts",
    "typecheck": "tsc -p packages/format && tsc -p packages/player && tsc -p packages/fonts && tsc -p packages/core && tsc -p packages/node && tsc -p packages/engine && tsc -p packages/cli && tsc -p .",
    "vendor": "node scripts/vendor-three.ts",
    "docs": "node scripts/gen-docs.ts",
    "gen": "node scripts/gen-format.ts && node scripts/gen-builtin-templates.ts && node scripts/gen-agent-rules.ts && node scripts/gen-ai-costs.ts",
    "costs:record": "node scripts/costs-record.ts",
    "fonts": "node scripts/fonts.ts",
    "sounds": "node scripts/sounds.ts",
    "fixtures:sources": "node scripts/source-fixtures.ts",
    "release:prepare": "node scripts/release.ts prepare",
    "release:check": "node scripts/release.ts check",
    "mcpb": "pnpm dlx @anthropic-ai/mcpb@2.1.2 validate plugins/claude-desktop/manifest.json && pnpm dlx @anthropic-ai/mcpb@2.1.2 pack plugins/claude-desktop dist/elabora.mcpb"
  },
  "devDependencies": {
    "@elabora/cli": "workspace:*",
    "@elabora/core": "workspace:*",
    "@elabora/engine": "workspace:*",
    "@elabora/fonts": "workspace:*",
    "@elabora/format": "workspace:*",
    "@elabora/node": "workspace:*",
    "@elabora/player": "workspace:*",
    "@types/node": "^24.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "^3.0.1",
    "sampo": "0.22.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.22.0"
}
