{
  "name": "elabora",
  "version": "0.1.0",
  "private": true,
  "description": "Open core of Elabora: an open e-learning source format, a validator, a SCORM 1.2 compiler with executable LMS profiles, a free-object contract, skills and an MCP server for AI agents.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/format",
    "packages/player",
    "packages/fonts",
    "packages/core",
    "packages/node",
    "packages/engine",
    "packages/cli"
  ],
  "bin": {
    "elabora": "bin/elabora.js"
  },
  "scripts": {
    "test": "node --test --test-global-setup=test/isolate.ts \"test/unit/*.test.ts\"",
    "test:e2e": "node --test --test-global-setup=test/isolate.ts --test-concurrency=2 \"test/e2e/*.test.ts\"",
    "test:matrix": "node --test --test-global-setup=test/isolate.ts --test-concurrency=2 \"test/matrix/*.test.ts\"",
    "test:all": "pnpm test && pnpm run test:e2e && pnpm run test:matrix",
    "typecheck": "tsc -p packages/format && tsc -p packages/player && tsc -p packages/fonts && tsc -p packages/core && tsc -p packages/node && tsc -p packages/engine && tsc -p packages/cli && tsc -p .",
    "vendor": "node scripts/vendor-three.ts",
    "docs": "node scripts/gen-docs.ts",
    "gen": "node scripts/gen-format.ts && node scripts/gen-builtin-templates.ts && node scripts/gen-agent-rules.ts && node scripts/gen-ai-costs.ts",
    "costs:record": "node scripts/costs-record.ts",
    "fonts": "node scripts/fonts.ts",
    "fixtures:sources": "node scripts/source-fixtures.ts",
    "release:prepare": "node scripts/release.ts prepare",
    "release:check": "node scripts/release.ts check"
  },
  "devDependencies": {
    "@elabora/cli": "workspace:*",
    "@elabora/core": "workspace:*",
    "@elabora/engine": "workspace:*",
    "@elabora/fonts": "workspace:*",
    "@elabora/format": "workspace:*",
    "@elabora/node": "workspace:*",
    "@elabora/player": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "pixelmatch": "^7.1.0",
    "playwright-core": "1.63.0",
    "pngjs": "^7.0.0",
    "sampo": "0.22.0",
    "three": "0.186.0",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@11.22.0"
}
