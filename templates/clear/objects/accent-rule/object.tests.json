{
  "$schema": "https://elabora.studio/schemas/0.1.5/object-tests.schema.json",
  "tests": [
    {
      "name": "The cover: the rule under the first part",
      "size": [
        1600,
        900
      ],
      "context": {
        "screen": "cover",
        "section": "opening",
        "sectionIndex": 0,
        "sectionCount": 5,
        "step": 1,
        "variant": "feature"
      },
      "steps": [
        {
          "action": "step",
          "frames": 5
        },
        {
          "action": "expect-state",
          "state": {
            "section": "opening",
            "index": 0,
            "count": 5,
            "moving": "none",
            "dark": false
          }
        },
        {
          "action": "snapshot",
          "name": "cover"
        }
      ]
    },
    {
      "name": "The rail runs along the player's top bar",
      "size": [
        1600,
        900
      ],
      "safeArea": {
        "top": 72,
        "right": 0,
        "bottom": 0,
        "left": 0
      },
      "context": {
        "screen": "cover",
        "section": "opening",
        "sectionIndex": 0,
        "sectionCount": 5,
        "step": 1,
        "variant": null
      },
      "steps": [
        {
          "action": "step",
          "frames": 2
        },
        {
          "action": "expect-state",
          "state": {
            "rail": 72
          }
        },
        {
          "action": "set-safe-area",
          "safeArea": {
            "top": 96,
            "right": 0,
            "bottom": 0,
            "left": 0
          }
        },
        {
          "action": "step",
          "frames": 2
        },
        {
          "action": "expect-state",
          "state": {
            "rail": 96
          }
        }
      ]
    },
