{
  "$schema": "https://elabora.studio/schemas/0.1.7/course.schema.json",
  "format": "elabora/0.1",
  "id": "clear",
  "title": "Your module title",
  "description": "Clear: a sober, brand-ready template for compliance, procedures, HR and internal communication, and for classic presentations. A strict grid, one accent, and a single movement: an accent rule that travels under the top bar to mark the current part.",
  "language": "en",
  "version": "1.0.0",
  "durationMinutes": 15,
  "sections": [
    {
      "id": "opening",
      "title": "Getting started",
      "screens": [
        "cover",
        "objectives"
      ]
    },
    {
      "id": "part-1",
      "title": "First part title",
      "screens": [
        "part-one",
        "key-message",
        "text-and-picture",
        "cards"
      ]
    },
    {
      "id": "part-2",
      "title": "Second part title",
      "screens": [
        "key-figures",
        "practice",
        "steps",
        "quote"
      ]
    },
    {
      "id": "part-3",
      "title": "Third part title",
      "screens": [
        "comparison",
        "chart"
      ]
    },
    {
      "id": "closing",
      "title": "Wrapping up",
      "screens": [
        "recap",
        "the-end"
      ]
    }
  ],
  "variables": [],
  "speakers": [
    {
      "id": "colleague",
      "name": "Alex, a colleague",
      "color": "color.accent"
    }
  ],
  "theme": {
    "cascade": "components-over-theme",
    "fonts": [
      {
        "family": "Inter",
        "src": "theme/fonts/inter/inter-latin-wght-normal.woff2",
        "weight": "100 900"
      },
      {
        "family": "Inter",
        "src": "theme/fonts/inter/inter-latin-wght-italic.woff2",
        "weight": "100 900",
        "style": "italic"
      }
    ],
    "tokens": {
      "font.body": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "font.heading": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "color.primary": "#15191F",
      "color.onPrimary": "#FFFFFF",
      "color.accent": "#1B56D1",
      "color.surface": "#FFFFFF",
      "color.text": "#15191F",
      "color.muted": "#4F5763",
      "color.success": "#1E7A4C",
      "color.error": "#B42318",
      "color.focus": "#1B56D1",
      "radius": 2,
      "player.top.background": "#FFFFFF",
      "player.top.text": "#15191F",
      "player.bottom.background": "#FFFFFF",
      "player.bottom.text": "#15191F",
      "player.accent": "#1B56D1",
      "player.onAccent": "#FFFFFF",
      "player.radius": 2
    },
    "custom": {
      "color.paper": "#F4F5F7",
      "color.line": "#DADDE2",
      "color.on-accent": "#FFFFFF",
      "color.ground-dark": "#11151B",
      "color.paper-dark": "#1B2029",
      "color.text-on-dark": "#EEF1F5",
      "color.muted-on-dark": "#A9B1BD",
      "color.accent-on-dark": "#8FB0FF"
    },
    "stylesheet": "theme/theme.css",
    "styles": {
      "screen": {
        "cover": {
          "label": "Cover",
          "description": "The title on the left seven columns, the accent panel on the right (with the Accent panel backdrop)"
        },
        "section": {
          "label": "Part opener",
          "description": "The part's number set large in the accent, the title on the left columns (with the Accent panel backdrop)"
        }
      },
      "text": {
        "lead": {
          "label": "Lead",
          "description": "Large introductory paragraph"
        },
        "agenda": {
          "label": "Agenda",
          "description": "One row per part, large numbers, hairlines between rows"
        },
        "checklist": {
          "label": "Checklist",
          "description": "Ticked list on hairlines: takeaways, recap"
        },
        "meta": {
          "label": "At a glance",
          "description": "Short facts in a row, separated by hairlines (audience, duration, owner)"
        }
      },
      "columns": {
        "cards": {
          "label": "Cards",
          "description": "Each column on a flat card, numbered in the accent colour"
        },
        "compare": {
          "label": "Face to face",
          "description": "Two columns face to face: the first in grey, the second outlined in the accent"
        }
      },
      "statement": {
        "accent": {
          "label": "Accent rule",
          "description": "The statement set large with a short accent rule above it"
        }
      }
    },
    "backdrop": {
      "layers": [
        "ground",
        "tint",
        "panel"
      ],
      "object": {
        "id": "accent-rule",
        "props": {}
      },
      "variants": {
        "feature": {
          "label": "Accent panel",
          "description": "On the right columns: cover, part openers and the end"
        },
        "tint": {
          "label": "Pale accent",
          "description": "A pale wash of the accent: a key message, a moment that stands out"
        },
        "ink": {
          "label": "Dark",
          "description": "Dark ground, light text, a lighter accent"
        }
      }
    }
  },
  "navigation": {
    "mode": "linear",
    "lockUntilComplete": true
  },
  "player": {
    "top": {
      "items": [
        {
          "id": "logo",
          "options": {
            "asset": "images/logo.svg",
            "alt": "Your organisation"
          }
        },
        {
          "id": "title"
        },
        {
          "id": "spacer"
        },
        {
          "id": "resources"
        },
        {
          "id": "glossary"
        },
        {
          "id": "credits"
        },
        {
          "id": "exit"
        }
      ]
    },
    "bottom": {
      "items": [
        {
          "id": "outline"
        },
        {
          "id": "controls"
        },
        {
          "id": "spacer"
        },
        {
          "id": "previous"
        },
        {
          "id": "next"
        }
      ]
    }
  },
  "completion": {
    "reportAs": "completed-incomplete"
  },
  "tracking": {
    "exitAfterCompletion": "suspend",
    "recordInteractions": true,
    "heartbeatSeconds": 60
  },
  "presentation": {
    "mode": "slides",
    "contentWidth": 760,
    "wideWidth": 1240,
    "fit": {
      "reference": "1600x900",
      "minimum": "1280x720"
    }
  }
}
