      "size": [
        1600,
        900
      ],
      "context": {
        "screen": "cover",
        "section": "opening",
        "sectionIndex": 0,
        "sectionCount": 5,
        "step": 1,
        "variant": "hero"
      },
      "steps": [
        {
          "action": "step",
          "frames": 30
        },
        {
          "action": "snapshot",
          "name": "hero"
        },
        {
          "action": "set-context",
          "context": {
            "screen": "objectives",
            "section": "opening",
            "sectionIndex": 0,
            "sectionCount": 5,
            "step": 1,
            "variant": "calm",
            "direction": "forward"
