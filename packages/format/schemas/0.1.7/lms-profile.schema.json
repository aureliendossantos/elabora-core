{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elabora.studio/schemas/0.1.7/lms-profile.schema.json",
  "title": "Executable LMS profile (profiles/<id>.json)",
  "description": "What one LMS documents about SCORM delivery, used both by the compiler (budgets, packaging rules, update policy) and by the emulator (launch mode, API topology, data limits). null means unknown: the field is listed in toMeasure and must be measured in a real instance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "documentedAt", "sources", "standards", "launch", "datamodel", "packaging", "update", "toMeasure"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,47}$" },
    "name": { "type": "string" },
    "documentedAt": { "type": "string", "description": "Date of the documentation the profile is based on (YYYY-MM-DD or YYYY-MM)." },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": { "title": { "type": "string" }, "url": { "type": "string" } }
      }
    },
    "standards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scorm12"],
      "properties": {
        "scorm12": { "type": "boolean" },
        "scorm2004": { "type": ["array", "null"], "items": { "enum": ["2nd", "3rd", "4th"] }, "description": "Editions really processed. Empty: not supported." },
        "sequencing": { "type": ["boolean", "null"] },
        "multiSco": { "type": ["boolean", "null"] },
        "cmi5": { "enum": [true, false, "plugin", "beta", null] },
        "xapi": { "enum": [true, false, "plugin", "discouraged", null] },
        "lti13": { "enum": [true, false, "partners-only", null] },
        "aicc": { "type": ["boolean", "null"] }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "modes"],
      "properties": {
        "default": { "enum": ["iframe", "popup", "popup-chain", "nested-iframe", "new-tab"] },
        "modes": { "type": "array", "items": { "enum": ["iframe", "popup", "popup-chain", "nested-iframe", "new-tab"] }, "minItems": 1, "description": "Topologies to emulate. popup-chain: content in a window opened by a window opened by the LMS (API at top.opener.opener). nested-iframe: one more iframe level (Docebo theater/inline)." },
        "apiDiscovery": { "type": "array", "items": { "enum": ["parents", "opener", "top.opener", "top.opener.opener"] } },
        "iframeAllow": { "type": "string", "description": "allow attribute set by the LMS on ancestor iframes, if documented." }
      }
    },
    "datamodel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suspendDataMax": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scorm12": { "type": ["integer", "null"] },
            "scorm2004": { "type": ["integer", "null"] }
          }
        },
        "suspendDataEnforcement": { "enum": ["reject", "truncate", "accept", null], "description": "What happens above the limit, if known." },
        "lessonLocationMax": { "type": ["integer", "null"] },
        "masteryOverridesStatus": { "type": ["boolean", "null"], "description": "The LMS recomputes lesson_status from score and mastery score (Moodle, Totara)." },
        "objectivesNeedPreexistingIds": { "type": ["boolean", "null"] },
        "scoreFormula": { "type": ["string", "null"] }
      }
    },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "needsExplicitFinish": { "type": ["boolean", "null"], "description": "Closing the window without LMSFinish loses the final session time or status." },
        "logoutEndsLmsSession": { "type": ["boolean", "null"] },
        "completionOnlyOnClose": { "type": ["boolean", "null"] }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autocommitSeconds": { "type": ["integer", "null"] },
        "keepalivePingSeconds": { "type": ["integer", "null"] },
        "maxSessionHours": { "type": ["number", "null"] },
        "inactivityTimeoutHours": { "type": ["number", "null"] }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unloadHeaderSent": { "type": ["boolean", "null"], "description": "Does the LMS re-enable unload with a Permissions-Policy header? Unknown for most." },
        "thirdPartyCookiesRequired": { "type": ["boolean", "null"] },
        "knownBugs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "packaging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxZipMB": { "type": ["number", "null"] },
        "maxUnzippedMB": { "type": ["number", "null"] },
        "maxFiles": { "type": ["integer", "null"] },
        "maxCompressionRatio": { "type": ["number", "null"] },
        "asciiFilenames": { "type": ["boolean", "null"] },
        "schemaversionRequired": { "type": ["boolean", "null"] },
        "oneStandardPerZip": { "type": ["boolean", "null"] },
        "forbiddenExtensions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family"],
      "properties": {
        "family": {
          "enum": ["in-place-if-same-structure", "lms-versioning", "replace-loses-progress", "auto-update", null],
          "description": "in-place-if-same-structure: the package can be replaced if the manifest structure is identical. lms-versioning: the LMS creates a new version or revision. replace-loses-progress: replacing the package loses learner progress. auto-update: the LMS re-reads the package (Moodle external packages)."
        },
        "notes": { "type": "string" }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "description": "Emulator settings.",
      "properties": {
        "autocommitSeconds": { "type": ["integer", "null"] },
        "syncCommits": { "type": "boolean", "default": true, "description": "Commit with synchronous XHR, like many LMSs (blocked during page dismissal)." }
      }
    },
    "toMeasure": {
      "type": "array",
      "items": { "type": "string" },
      "description": "JSON Pointers of fields that are unknown or contradictory and must be measured in a real instance."
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
