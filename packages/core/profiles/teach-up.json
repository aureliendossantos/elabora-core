{
  "$schema": "https://elabora.studio/schemas/0.1.9/lms-profile.schema.json",
  "id": "teach-up",
  "name": "Teach Up (import)",
  "documentedAt": "2026-09",
  "sources": [
    {
      "title": "Insérer un module SCORM",
