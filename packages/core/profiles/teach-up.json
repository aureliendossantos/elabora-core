    "maxZipMB": 100,
    "maxFiles": null,
    "asciiFilenames": null,
    "schemaversionRequired": null,
    "oneStandardPerZip": null
  },
  "update": {
    "family": null
  },
  "harness": {
    "autocommitSeconds": null,
    "syncCommits": true
  },
  "toMeasure": [
    "/standards/scorm2004",
    "/datamodel/suspendDataMax/scorm12",
    "/update/family"
