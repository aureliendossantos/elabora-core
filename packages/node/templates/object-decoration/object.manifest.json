{
  "$schema": "https://elabora.studio/schemas/0.1.4/object-manifest.schema.json",
  "manifestVersion": "0.1",
  "id": "__ID__",
  "version": "0.1.0",
  "title": "__TITLE__",
  "pedagogicalRole": "decoration",
  "props": {
    "type": "object",
    "properties": {
      "tint": { "type": "string", "format": "color", "default": "#C2410C", "description": "Colour of the glow", "x-group": "Style", "x-control": "color", "x-token": "color.accent" },
      "strength": { "type": "number", "minimum": 0, "maximum": 1, "multipleOf": 0.05, "default": 0.35, "description": "How strong the glow is", "x-group": "Style", "x-control": "slider" },
      "travel": { "type": "number", "minimum": 0, "maximum": 3, "multipleOf": 0.1, "default": 1.2, "description": "Seconds the glow takes to move to its place on another screen", "x-group": "Motion", "x-control": "slider" }
    },
    "required": ["tint", "strength", "travel"]
  },
  "state": {
    "type": "object",
    "properties": { "screenIndex": { "type": "integer", "minimum": 0 }, "sectionIndex": { "type": ["integer", "null"] } },
    "required": ["screenIndex", "sectionIndex"]
  },
  "events": [],
  "budgets": { "bootMsMax": 1500 },
  "a11y": { "motion": { "pausable": true, "respectsReducedMotion": true } },
  "sandbox": { "network": "none", "permissions": [] }
}
