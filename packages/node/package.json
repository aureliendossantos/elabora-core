{
  "name": "@elabora/node",
  "private": true,
  "version": "0.1.0",
  "description": "Elabora services for Node: file store, build and packaging, media, backups, LMS emulator, free-object gates, preview and captures.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
