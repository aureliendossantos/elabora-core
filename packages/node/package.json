    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@elabora/core": "workspace:*",
    "@elabora/fonts": "workspace:*",
    "@elabora/format": "workspace:*",
    "@elabora/player": "workspace:*",
    "d3": "7.9.0",
    "esbuild": "0.28.2",
    "three": "0.186.0"
  },
  "optionalDependencies": {
    "axe-core": "4.13.0",
    "onnxruntime-node": "1.23.2",
    "pixelmatch": "^7.1.0",
    "playwright-core": "1.63.0",
    "pngjs": "^7.0.0",
    "scorm-again": "3.4.4"
  }
}
