{
  "$schema": "https://elabora.studio/schemas/0.1.11/course.schema.json",
  "format": "elabora/0.1",
  "id": "placement-fixture",
  "title": "Blocks placed by hand",
  "language": "en",
  "version": "0.1.0",
  "sections": [
    { "id": "first", "title": "First", "screens": ["sketch", "page"] }
  ],
  "theme": { "cascade": "components-over-theme" },
  "navigation": { "mode": "free", "lockUntilComplete": false },
  "player": {
    "top": { "items": [{ "id": "title" }, { "id": "progress" }, { "id": "spacer" }, { "id": "exit" }] },
    "bottom": { "items": [{ "id": "outline" }, { "id": "spacer" }, { "id": "previous" }, { "id": "next" }] }
  },
  "presentation": { "mode": "slides" },
  "completion": { "reportAs": "completed-incomplete" },
  "tracking": { "exitAfterCompletion": "suspend", "recordInteractions": true, "heartbeatSeconds": 60 }
}
