{
  "$schema": "https://elabora.studio/schemas/0.1.8/component.schema.json",
  "id": "detail-list",
  "title": "Details to open",
  "description": "Questions learners may open, each a native disclosure (<details data-t-details>) visited once opened.",
  "instructions": "Two to eight questions of one line, each answered in a few sentences.",
  "category": "content",
  "version": "1.0.0",
  "level": "block",
  "props": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "items"
    ],
    "properties": {
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "description": "The questions.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "markdown"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,24}$",
              "description": "Stable id of the item: its visited mark and its translations name it."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "x-translatable": true,
              "description": "The question."
            },
            "markdown": {
              "type": "string",
              "x-kind": "markdown",
              "x-translatable": true,
              "description": "Its answer."
            }
          }
        }
      }
    }
  }
}
