{
  "$schema": "https://elabora.studio/schemas/0.1.7/component.schema.json",
  "id": "zoom-images",
  "title": "Images to enlarge",
  "description": "A row of images with their captions; each opens at full size in the player's lightbox (data-t-zoom), with previous and next between them.",
  "instructions": "One to eight images, each with an alt that says what it shows and a caption of one sentence.",
  "category": "content",
  "version": "1.0.0",
  "level": "block",
  "props": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "images"
    ],
    "properties": {
      "images": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "description": "The images.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "asset",
            "alt"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,24}$",
              "description": "Stable id of the item: its visited mark and its translations name it."
            },
            "asset": {
              "type": "string",
              "x-kind": "asset",
              "description": "The image."
            },
            "alt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 250,
              "x-translatable": true,
              "description": "What the image shows."
            },
            "caption": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "x-translatable": true,
              "description": "One sentence under the image."
            }
          }
        }
      }
    }
  }
}
