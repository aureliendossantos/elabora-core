  "glossary": [
    {
      "id": "lock",
      "term": "Lock",
      "definition": "A short stretch of canal closed by gates at each end, where boats change level. Water is let in or out until the level matches the canal the boat is heading for.",
      "variants": [
        "locks",
        "canal lock"
      ]
    },
    {
      "id": "lock-chamber",
      "term": "Lock chamber",
      "definition": "The stone basin of a lock, between its two pairs of gates. The boat waits there while the water rises or falls around it.",
      "variants": [
        "chamber"
      ]
    },
    {
      "id": "gates",
      "term": "Lock gates",
      "definition": "The pairs of heavy wooden doors that close each end of the chamber. They only open when the water is at the same level on both sides: until then, the higher water presses them shut.",
      "variants": [
        "gates",
        "gate"
      ]
    },
    {
      "id": "balance-beam",
      "term": "Balance beam",
      "definition": "The long arm on top of each gate. The lock keeper leans on it to swing the gate open or shut, once the water is level.",
      "variants": [
        "balance beams"
      ]
    },
    {
      "id": "paddle",
      "term": "Paddle",
      "definition": "A small sluice in a gate or beside it. Winding it up lets water flow through without opening the gate: that is how a lock fills or empties.",
      "variants": [
        "paddles",
        "sluice",
        "sluices"
      ]
    },
    {
      "id": "upstream",
      "term": "Upstream",
      "definition": "Towards where the water comes from. At a lock, the upstream side is the upper canal, the higher water.",
      "variants": []
    },
    {
      "id": "downstream",
      "term": "Downstream",
      "definition": "Towards where the water goes. At a lock, the downstream side is the lower canal, the lower water.",
      "variants": []
    },
    {
      "id": "lock-keeper",
      "term": "Lock keeper",
      "definition": "The person who looks after a lock and works its gates and paddles to help boats through.",
      "variants": [
        "lock-keeper",
        "lock keepers"
      ]
    },
    {
      "id": "barge",
      "term": "Barge",
      "definition": "A long, flat-bottomed boat built for canals. Barges once carried goods; many are now homes or holiday boats.",
      "variants": [
        "barges"
      ]
    }
  ]
