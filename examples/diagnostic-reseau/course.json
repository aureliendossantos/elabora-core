      "title": "Valider",
      "screens": [
        "evaluation",
        "bilan"
      ]
    }
  ],
  "variables": [
    {
      "id": "bonsReflexes",
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 10,
      "description": "Nombre de bons réflexes choisis dans le scénario."
    },
    {
      "id": "indiceVu",
      "type": "boolean",
      "default": false,
      "description": "L'apprenant a eu besoin d'un indice dans la simulation."
    }
  ],
