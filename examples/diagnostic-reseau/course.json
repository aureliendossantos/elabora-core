      "asset": "resources/equipements-siege.csv"
    }
  ],
  "glossary": [
    {
      "id": "commutateur",
      "term": "Commutateur",
      "definition": "Équipement qui relie les postes d'un même étage et leur transmet les paquets qui leur sont destinés.",
      "variants": [
        "switch"
      ]
    },
    {
      "id": "routeur",
      "term": "Routeur",
      "definition": "Équipement qui oriente les paquets d'un réseau à l'autre, par exemple du réseau des bureaux vers celui des serveurs."
    },
    {
      "id": "pare-feu",
      "term": "Pare-feu",
      "definition": "Équipement qui filtre les flux entre réseaux selon des règles : une règle mal écrite peut bloquer l'impression.",
      "variants": [
        "firewall"
      ]
    },
    {
      "id": "serveur-impression",
      "term": "Serveur d'impression",
      "definition": "Serveur qui reçoit les demandes d'impression et les transmet aux imprimantes, dans l'ordre de sa file d'attente."
    },
    {
      "id": "adresse-ip",
      "term": "Adresse IP",
      "definition": "Numéro qui identifie un appareil sur le réseau. Sans adresse valide, le poste ne peut joindre aucun serveur.",
      "variants": [
        "IP"
      ]
    },
    {
      "id": "paquet",
      "term": "Paquet",
      "definition": "Petit morceau de données qui voyage sur le réseau. Une demande d'impression part en plusieurs paquets.",
      "variants": [
        "paquets"
      ]
    },
    {
      "id": "file-attente",
      "term": "File d'attente",
      "definition": "Liste des impressions en attente sur le serveur. Une demande bloquée en tête arrête toutes celles qui la suivent.",
      "variants": [
        "spouleur"
      ]
    }
  ],
