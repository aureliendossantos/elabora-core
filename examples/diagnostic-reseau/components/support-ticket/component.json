{
  "$schema": "https://elabora.studio/schemas/0.1.12/component.schema.json",
  "id": "support-ticket",
  "title": "Ticket de support",
  "version": "2.0.0",
  "level": "block",
  "category": "content",
  "description": "Un ticket de support : référence, priorité, objet, demandeur avec son portrait, ouverture et échéance.",
  "instructions": "Renseignez les champs du ticket. Le portrait est facultatif.",
  "props": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "reference",
      "priority",
      "subject",
      "requester",
      "timing"
    ],
    "properties": {
      "reference": {
        "type": "string",
        "title": "Référence",
        "minLength": 1,
        "maxLength": 80,
        "x-translatable": true
      },
      "priority": {
        "type": "string",
        "title": "Priorité",
        "minLength": 1,
        "maxLength": 60,
        "x-translatable": true
      },
      "subject": {
        "type": "string",
        "title": "Objet",
        "minLength": 1,
        "maxLength": 200,
        "x-translatable": true
      },
      "requester": {
        "type": "string",
        "title": "Demandeur",
        "minLength": 1,
        "maxLength": 200,
        "x-translatable": true
      },
      "timing": {
        "type": "string",
        "title": "Ouverture et échéance",
        "minLength": 1,
        "maxLength": 200,
        "x-translatable": true
      },
      "photo": {
        "type": "string",
        "title": "Portrait du demandeur",
        "x-kind": "asset"
      }
    }
  },
  "fallback": [
    {
      "type": "callout",
      "props": {
        "variant": "info",
        "title": "{{subject}}",
        "markdown": "{{reference}} · {{priority}}\n\n{{requester}}\n\n{{timing}}"
      }
    }
  ],
  "examples": [
    {
      "title": "Le ticket de Marc",
      "props": {
        "reference": "Ticket 4127",
        "priority": "Priorité haute",
        "subject": "Impossible d'imprimer les bulletins de paie",
        "requester": "Marc, comptabilité, 2e étage",
        "timing": "Ouvert lundi à 9 h 05 · Avant midi",
        "photo": "images/portrait-marc.svg"
      }
    }
  ]
}
