{
  "$schema": "https://elabora.studio/schemas/0.1.12/screen.schema.json",
  "id": "accueil",
  "title": "Diagnostiquer une panne d'impression réseau",
  "covers": [
    "ITEM-1"
  ],
  "layout": "stage",
  "layoutProps": {
    "arrangement": "opening"
  },
  "blocks": [
    {
      "id": "accueil-mission",
      "type": "text",
      "style": "lead",
      "props": {
        "textRef": "TXT-1"
      }
    },
    {
      "id": "accueil-ticket",
      "type": "support-ticket",
      "props": {
        "reference": "Ticket 4127",
        "priority": "Priorité haute",
        "subject": "Impossible d'imprimer les bulletins de paie",
        "requester": "Marc, comptabilité, 2e étage",
        "timing": "Ouvert lundi à 9 h 05",
        "photo": "images/portrait-marc.svg"
      }
    },
    {
      "id": "accueil-go",
      "type": "button",
      "style": "go",
      "props": {
        "label": "Prendre le ticket",
        "variant": "primary"
      }
    },
    {
      "id": "accueil-reseau",
      "type": "free-object",
      "slot": "scene",
      "optional": true,
      "continuity": {
        "key": "reseau",
        "duration": 1000
      },
      "props": {
        "object": "diagnostic-reseau",
        "title": "Le réseau du siège, du poste de Marc à l'imprimante",
        "aspectRatio": "fill",
        "narrowAspectRatio": "4:3",
        "minHeight": 360,
        "props": {
          "mode": "display",
          "reach": -1,
          "focus": "poste",
          "showZones": false
        },
        "a11y": {
          "description": "Le réseau du siège sur un plateau : le poste de Marc, mis en avant, le commutateur de l'étage, le routeur, le pare-feu, le serveur d'impression et l'imprimante, reliés par des câbles."
        },
        "textAlternative": "**Version texte de la scène.** Le réseau du siège, posé sur un plateau : le poste de Marc, le commutateur de l'étage, le routeur, le pare-feu, le serveur d'impression et l'imprimante, reliés par des câbles dans cet ordre."
      }
    }
  ],
  "events": [
    {
      "id": "accueil-go-suite",
      "description": "Le bouton mène au chemin d'une impression.",
      "on": {
        "type": "click",
        "target": "accueil-go"
      },
      "do": [
        {
          "type": "go-to",
          "screen": "next"
        }
      ]
    }
  ]
}
