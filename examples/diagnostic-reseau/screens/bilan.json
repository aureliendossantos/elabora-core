{
  "$schema": "https://elabora.studio/schemas/0.1.12/screen.schema.json",
  "id": "bilan",
  "title": "Deux nouveaux tickets",
  "covers": [
    "ITEM-5",
    "ITEM-6"
  ],
  "style": "wide",
  "completeWhen": "interactions-done",
  "steps": {
    "2": {
      "opens": "answered"
    }
  },
  "blocks": [
    {
      "id": "bilan-questions",
      "type": "columns",
      "width": "wide",
      "props": {
        "count": 2
      },
      "blocks": [
        {
          "id": "bilan-q1",
          "type": "quiz",
          "slot": "first",
          "props": {
            "questionRef": "Q-1",
            "feedbackStyle": "compact"
          }
        },
        {
          "id": "bilan-q2",
          "type": "quiz",
          "slot": "second",
          "props": {
            "questionRef": "Q-2",
            "feedbackStyle": "compact"
          }
        }
      ]
    },
    {
      "id": "bilan-resultat",
      "type": "results",
      "width": "wide",
      "step": 2,
      "props": {
        "allowRetry": true,
        "passedMessage": "Vous savez localiser une panne en suivant le chemin des paquets. La fiche réflexe SUP-NET-04 vous attend dans **Ressources**.",
        "failedMessage": "Reprenez le chemin depuis le poste, puis réessayez. La fiche réflexe SUP-NET-04 est dans **Ressources**."
      }
    }
  ]
}
