{
  "$schema": "https://elabora.studio/schemas/0.1.11/screen.schema.json",
  "id": "orbits",
  "title": "Lower is faster",
  "covers": ["ITEM-2"],
  "layout": "split",
  "layoutProps": { "balance": "figure", "figure": "stack" },
  "blocks": [
    {
      "id": "orbits-earth", "type": "image", "slot": "figure", "style": "bare",
      "props": { "asset": "images/orbits-earth.svg", "alt": "The Earth, drawn to the same scale as the three orbits around it.", "caption": "To scale. Each trail is one hour of flight." }
    },
    { "id": "orbits-hot-1", "type": "hotspot", "slot": "figure", "props": { "marker": "1", "label": "Orbit 1: Space Station", "x": 62.2, "y": 46.1, "accent": "color.servicer" } },
    {
      "id": "orbits-flight-1", "type": "orbit-flight", "slot": "figure", "step": 2,
      "props": { "craft": "images/orbit-1-craft.svg", "trail": "images/orbit-1-trail.svg", "at": 32, "sweep": 232.3, "alt": "Orbit 1, the Space Station, hugs the Earth. In one hour it flies almost two thirds of a lap, and its speed arrow is the longest." }
    },
    { "id": "orbits-hot-2", "type": "hotspot", "slot": "figure", "step": 2, "props": { "marker": "2", "label": "Orbit 2: GPS", "x": 23.2, "y": 33.2, "accent": "color.orbit" } },
    {
      "id": "orbits-flight-2", "type": "orbit-flight", "slot": "figure", "step": 3,
      "props": { "craft": "images/orbit-2-craft.svg", "trail": "images/orbit-2-trail.svg", "at": 148, "sweep": 30.1, "alt": "Orbit 2, GPS, lies far out. In one hour it covers only a twelfth of a lap, with a short speed arrow." }
    },
    { "id": "orbits-hot-3", "type": "hotspot", "slot": "figure", "step": 3, "props": { "marker": "3", "label": "Orbit 3: geostationary", "x": 79.4, "y": 87.6, "accent": "color.client" } },
    {
      "id": "orbits-flight-3", "type": "orbit-flight", "slot": "figure", "step": 4,
      "props": { "craft": "images/orbit-3-craft.svg", "trail": "images/orbit-3-trail.svg", "at": -52, "sweep": 15, "alt": "Orbit 3, geostationary, is the farthest. In one hour it covers a twenty-fourth of a lap, with the shortest speed arrow." }
    },
    { "id": "orbits-ask", "type": "text", "slot": "body", "style": "lead", "props": { "markdown": "Three orbits, three heights. Which one goes round fastest? Select 1, 2, then 3." } },
    { "id": "orbits-iss", "type": "stat-line", "slot": "body", "step": 2, "props": { "marker": "1", "value": "1 h 33", "unit": "per lap", "label": "The Space Station, 420 km up", "accent": "color.servicer" } },
    { "id": "orbits-gps", "type": "stat-line", "slot": "body", "step": 3, "props": { "marker": "2", "value": "12 h", "unit": "per lap", "label": "GPS satellites, 20,200 km up", "accent": "color.orbit" } },
    { "id": "orbits-geo", "type": "stat-line", "slot": "body", "step": 4, "props": { "marker": "3", "value": "24 h", "unit": "per lap", "label": "Geostationary satellites, 35,786 km up", "accent": "color.client" } },
    { "id": "orbits-why", "type": "statement", "slot": "body", "step": 4, "props": { "textRef": "TXT-2", "align": "start" } }
  ],
  "events": [
    { "id": "select-orbit-1", "description": "The first marker flies the Space Station's orbit, then shows its lap.", "on": { "type": "click", "target": "orbits-hot-1" }, "do": [ { "type": "reveal-step", "step": 2 } ] },
    { "id": "select-orbit-2", "description": "The second marker flies the GPS orbit, then shows its lap.", "on": { "type": "click", "target": "orbits-hot-2" }, "do": [ { "type": "reveal-step", "step": 3 } ] },
    { "id": "select-orbit-3", "description": "The third marker flies the geostationary orbit, then shows its lap and why.", "on": { "type": "click", "target": "orbits-hot-3" }, "do": [ { "type": "reveal-step", "step": 4 } ] }
  ]
}
