{
  "$schema": "https://elabora.studio/schemas/0.1.12/screen.schema.json",
  "id": "assessment",
  "title": "Plan one yourself",
  "covers": ["ITEM-6"],
  "completeWhen": "interactions-done",
  "steps": { "2": { "opens": "answered" }, "3": { "opens": "answered" } },
  "blocks": [
    { "id": "assessment-calc", "type": "numeric", "width": "half", "props": { "questionRef": "Q-1" } },
    { "id": "assessment-next", "type": "quiz", "width": "half", "step": 2, "props": { "questionRef": "Q-2", "feedbackStyle": "compact" } },
    {
      "id": "assessment-results", "type": "results", "width": "wide", "step": 3,
      "props": {
        "allowRetry": true,
        "passedMessage": "You can plan a rendezvous: **brake to gain, then push back at the same point.**",
        "failedMessage": "Go back to the lab, then try again: each m/s of braking gains about 17 km per lap."
      }
    }
  ]
}
