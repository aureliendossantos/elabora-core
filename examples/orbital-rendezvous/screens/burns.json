{
  "$schema": "https://elabora.studio/schemas/0.1.12/screen.schema.json",
  "id": "burns",
  "title": "The first push",
  "covers": [
    "ITEM-4",
    "ITEM-3"
  ],
  "layout": "split",
  "layoutProps": {
    "balance": "activity",
    "figure": "stack"
  },
  "completeWhen": "interactions-done",
  "steps": {
    "2": {
      "opens": "answered"
    }
  },
  "blocks": [
    {
      "id": "burns-figure",
      "type": "image",
      "slot": "figure",
      "style": "bare",
      "props": {
        "asset": "images/burn-situation.svg",
        "alt": "Your spacecraft and the satellite on the same circular orbit around the Earth, the satellite a little ahead of you.",
        "caption": "You in orange, the satellite in violet. Both fly to the left."
      }
    },
    {
      "id": "burns-path",
      "type": "image",
      "slot": "figure",
      "style": "trace",
      "step": 2,
      "props": {
        "asset": "images/burn-path.svg",
        "alt": "Your new path after braking at 1: it dips inside the circle on the far side (2), then comes back to 1, closer to the satellite (3)."
      }
    },
    {
      "id": "burns-thrust",
      "type": "image",
      "slot": "figure",
      "style": "bare",
      "step": 2,
      "props": {
        "asset": "images/burn-thrust.svg",
        "decorative": true
      }
    },
    {
      "id": "burns-practice",
      "type": "maneuver-quiz",
      "slot": "body",
      "props": {
        "stem": "The satellite is **50 km ahead**, on your orbit. Which way do you push?",
        "mode": "single",
        "scored": false,
        "attempts": 1,
        "feedbackStyle": "compact",
        "objective": "OBJ-1",
        "options": [
          {
            "id": "a",
            "text": "Forwards, towards it",
            "correct": false,
            "figure": "images/burn-prograde.svg",
            "feedback": "That is what Gemini 4 did: you climb, your laps get longer, and the satellite pulls away."
          },
          {
            "id": "b",
            "text": "Backwards, to brake",
            "correct": true,
            "figure": "images/burn-retrograde.svg",
            "feedback": "Yes: braking brings you closer."
          },
          {
            "id": "c",
            "text": "Down, towards the Earth",
            "correct": false,
            "figure": "images/burn-radial.svg",
            "feedback": "Your lap stays as long: one lap later, you are still 50 km behind."
          }
        ]
      }
    },
    {
      "id": "burns-explain",
      "type": "text",
      "slot": "body",
      "style": "legend",
      "step": 2,
      "props": {
        "textRef": "TXT-3"
      }
    }
  ]
}
