  "narration": {
    "lines": [
      {
        "id": "l1",
        "speaker": "guide",
        "text": "Now place each lure: how often it comes, and how often people click."
      },
      {
        "id": "l2",
        "speaker": "guide",
        "text": "Prize draws are rare and easy to spot. Delivery notices are common, but rarely fool us."
      },
      {
        "id": "l3",
        "speaker": "guide",
        "text": "Payroll messages are rare but convincing. Password resets and invoices are both."
      }
