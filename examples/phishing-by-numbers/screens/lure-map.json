            "at": {
              "line": "l2",
              "word": "Delivery"
            }
          },
          {
            "id": "payroll",
            "label": "Payroll message",
            "x": 0.28,
            "y": 0.76,
            "text": "Rare, but personal: people click",
            "at": {
              "line": "l3",
              "word": "Payroll"
            }
          },
          {
            "id": "password",
            "label": "Password reset",
            "x": 0.6,
