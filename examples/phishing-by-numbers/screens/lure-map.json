            "at": {
              "line": "l3",
              "word": "Password"
            }
          },
          {
            "id": "invoice",
            "label": "Invoice",
            "x": 0.72,
            "y": 0.84,
            "text": "Looks like real work, and asks for money",
            "at": {
              "line": "l3",
              "word": "invoices"
            }
          }
        ]
      }
