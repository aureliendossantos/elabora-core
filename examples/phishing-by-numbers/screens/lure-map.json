          "label": "How often people click",
          "low": "Rarely",
          "high": "Often"
        },
        "quadrants": {
          "topLeft": "Rare but convincing",
          "topRight": "Watch first",
          "bottomLeft": "Background noise",
          "bottomRight": "Common, easy to spot"
        },
        "highlightQuadrant": "topRight",
        "highlight": "invoice",
        "items": [
          {
            "id": "prize",
            "label": "Prize draw",
            "x": 0.16,
            "y": 0.12,
            "text": "Too good to be true, and everyone knows it",
            "at": {
              "line": "l2",
              "word": "Prize"
            }
          },
          {
            "id": "delivery",
            "label": "Delivery notice",
            "x": 0.88,
            "y": 0.34,
